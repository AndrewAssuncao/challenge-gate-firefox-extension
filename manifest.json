{
  "manifest_version": 2,
  "name": "Challenge Gate",
  "version": "1.0.0",
  "description": "Practice typing, Git, quant coding, brainteasers and quant mathematics before browsing.",
  "browser_specific_settings": {
    "gecko": {
      "id": "challenge-gate@extension",
      "strict_min_version": "102.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "idle",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "gate/spaced-repetition.js",
      "gate/challenge-provider.js",
      "gate/git-provider.js",
      "gate/terminal-provider.js",
      "learning/curriculum.js",
      "learning/engine.js",
      "learning/store.js",
      "background/background.js"
    ]
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    },
    "default_title": "Challenge Gate",
    "default_popup": "popup/popup.html"
  },
  "web_accessible_resources": [
    "gate/gate.html",
    "gate/gate.js",
    "gate/gate.css",
    "gate/typing.js",
    "gate/typing.css",
    "gate/python.js",
    "gate/python.css",
    "gate/cross-discipline.js",
    "gate/spaced-repetition.js",
    "gate/challenge-provider.js",
    "gate/terminal.js",
    "gate/terminal.css",
    "gate/terminal-provider.js",
    "gate/git.js",
    "gate/git.css",
    "gate/git-provider.js",
    "gate/pyodide-worker.js",
    "gate/challenges/*",
    "learning/curriculum.js",
    "learning/engine.js",
    "gate/quant.js",
    "gate/quant.css"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; object-src 'self';",
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  }
}
