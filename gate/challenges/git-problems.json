    "topic": "git_reflog",
    "tier": 4,
    "scenario": "You accidentally ran 'git reset --hard' and lost commits. Use reflog to find the lost commit SHA, then recover your work.",
    "initialState": {
      "commits": [
        { "sha": "a1b2c3d", "message": "Initial commit", "parents": [] },
        { "sha": "b2c3d4e", "message": "Important work", "parents": ["a1b2c3d"] }
      ],
      "branches": { "main": "a1b2c3d" },
      "HEAD": { "type": "branch", "ref": "main" }
    },
    "targetState": {
      "commits": [
        { "sha": "a1b2c3d", "message": "Initial commit", "parents": [] },
        { "sha": "b2c3d4e", "message": "Important work", "parents": ["a1b2c3d"] }
      ],
      "branches": { "main": "b2c3d4e" },
      "HEAD": { "type": "branch", "ref": "main" }
    },
    "objectives": [
      {
        "description": "Use reflog to find the lost commit",
        "validation": { "type": "commandUsed", "expected": "git reflog" }
      },
      {
