        { "sha": "b2c3d4e", "message": "Add feature A", "parents": ["a1b2c3d"] },
        { "sha": "c3d4e5f", "message": "Add feature B", "parents": ["b2c3d4e"] },
        { "sha": "d4e5f6a", "message": "Refactor utils", "parents": ["c3d4e5f"] },
        { "sha": "e5f6a7b", "message": "Update configs", "parents": ["d4e5f6a"] },
        { "sha": "f6a7b8c", "message": "Bug is here somewhere", "parents": ["e5f6a7b"] }
      ],
      "branches": { "main": "f6a7b8c" },
      "HEAD": { "type": "branch", "ref": "main" }
    },
    "targetState": {
      "commits": [
        { "sha": "a1b2c3d", "message": "Initial commit", "parents": [] },
        { "sha": "b2c3d4e", "message": "Add feature A", "parents": ["a1b2c3d"] },
        { "sha": "c3d4e5f", "message": "Add feature B", "parents": ["b2c3d4e"] },
        { "sha": "d4e5f6a", "message": "Refactor utils", "parents": ["c3d4e5f"] },
        { "sha": "e5f6a7b", "message": "Update configs", "parents": ["d4e5f6a"] },
        { "sha": "f6a7b8c", "message": "Bug is here somewhere", "parents": ["e5f6a7b"] }
      ],
      "branches": { "main": "f6a7b8c" },
      "HEAD": { "type": "branch", "ref": "main" }
    },
    "objectives": [
      {
        "description": "Start a bisect session",
        "validation": { "type": "commandUsed", "expected": "git bisect start" }
      },
      {
        "description": "Mark the current commit as bad",
        "validation": { "type": "commandUsed", "expected": "git bisect bad" }
      },
      {
        "description": "Mark a known good commit",
        "validation": { "type": "commandUsed", "expected": "git bisect good" }
      },
      {
        "description": "Reset bisect when done",
        "validation": { "type": "commandUsed", "expected": "git bisect reset" }
      }
    ],
    "hints": ["Start with 'git bisect start'", "Mark bad: 'git bisect bad', mark a good older commit: 'git bisect good <sha>'", "End with 'git bisect reset'"],
    "afterSolve": "Bisect uses binary search to find the commit that introduced a bug. With 1000 commits, it finds the culprit in ~10 steps instead of checking each one."
